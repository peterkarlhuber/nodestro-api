{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/peterkarlhuber/nodestro-api/master/contracts/app-api/v1/run-status.schema.json",
  "title": "RunStatus",
  "description": "A run: POST …/runs, GET …/runs/{id}, POST …/cancel, …/approve, …/resume.",
  "type": "object",
  "required": [
    "run_id",
    "status",
    "publication",
    "created_at",
    "usage",
    "steps",
    "approvals",
    "links"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "awaiting_approval",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "publication": {
      "type": "string"
    },
    "version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "label",
          "type",
          "status"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "approvals.schema.json#/$defs/Approval"
      }
    },
    "resumed_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "Usage": {
      "type": "object",
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "requests": {
          "type": "integer"
        },
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "total_tokens": {
          "type": "integer"
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
